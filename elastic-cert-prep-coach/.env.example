# Postgres (required — use postgres:// or postgresql://)
# From Vercel Prisma Postgres: copy from dashboard or run: vercel env pull .env.local
# DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# NextAuth (required for auth; use a random string in production)
NEXTAUTH_SECRET=your-secret-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# Optional: AI Study Coach — set to use OpenAI instead of mock responses
# OPENAI_API_KEY=sk-proj-...
